# DocPilot local development configuration
UPLOAD_FOLDER=uploads
VECTOR_STORE_PATH=vector_store
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# Ollama model name; install it with: ollama pull llama3.2:3b
LLM_MODEL=llama3.2:3b

# Uvicorn startup command in README specifies these values explicitly
HOST=127.0.0.1
PORT=8000
